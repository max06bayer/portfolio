  {
    "id": "9:2079",
    "x": 109,
    "y": 7343,
    "w": 1662,
    "h": 218,
    "align": "LEFT",
    "size": 26,
    "weight": "Regular",
    "line": 1.4900000095367432,
    "spacing": -0.78,
    "segments": [
      {
        "text": "Delphi is a project management platform focussed on efficiency and working together with agents. It adapts fully to your needs and treats agents the same as coworkers. You can connect it to Claude Code, Codex, Github Copilot or can deisgn your own custom agent in the App for specific tasks from a selection of thousands of LLMs. The agents can work together on tasks and take part in the chats and channels just like normal people. It is one work platform you can customize so you manage your entire stack in one place. This is the successor to BizzConnect a PM system I build earlier.",
        "color": {
          "r": 0.5397010445594788,
          "g": 0.5397010445594788,
          "b": 0.5397010445594788
        },
        "underline": false,
        "link": null
      }
    ]
  },
