  {
    "id": "9:2114",
    "x": 109,
    "y": 9180,
    "w": 1728,
    "h": 218,
    "align": "LEFT",
    "size": 26,
    "weight": "Regular",
    "line": 1.4900000095367432,
    "spacing": -0.78,
    "segments": [
      {
        "text": "BizzConnect was a time / project management platform focused on the smart automatic Calendar. It could reschedule automatically to make space for other events, dates and projects. It was a working online platform under bizzconnect.org where you could connect your entire team. Projects, Chats, Calls, Smart Calendars that could connect to Google Calendar and Outlook Calendar and would synch automatically and auto schedule tasks that were assigned to you. It also had a collaborative note editor, a company wide knowledge base and AI assistant integration. The AI was able to do any action you could too on its own too and you were able to choose from 25 LLM models. BizzConnect is shut down since September 2026. ",
        "color": {
          "r": 0.5397010445594788,
          "g": 0.5397010445594788,
          "b": 0.5397010445594788
        },
        "underline": false,
        "link": null
      }
    ]
  },
