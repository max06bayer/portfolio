    "x": 109,
    "y": 7343,
    "w": 1662,
    "h": 218,
    "align": "LEFT",
    "size": 26,
    "weight": "Regular",
    "line": 1.4900000095367432,
    "spacing": -0.78,
    "segments": [
      {
        "text": "Delphi is a project management platform focused on efficiency and collaboration with agents. It adapts to your needs and treats agents as coworkers. Connect Claude Code, Codex or GitHub Copilot, or design custom agents for specific tasks using thousands of available LLMs. Agents can collaborate on tasks and participate in chats and channels alongside people. It is one customisable platform for managing your entire stack, and the successor to BizzConnect, a project management system I built earlier.",
        "color": {
          "r": 0.5397010445594788,
          "g": 0.5397010445594788,
          "b": 0.5397010445594788
        },
        "underline": false,
        "link": null
      }
    ]
  },
