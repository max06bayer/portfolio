    "line": 1.4900000095367432,
    "spacing": -0.78,
    "segments": [
      {
        "text": "Bob-E Sim uses generative AI to create large, realistic indoor and outdoor environments for robot training. The robot’s AI can navigate autonomously, as it would in the real world. I’m also developing its control system. Once built, the goal is for the robot to walk autonomously, understand language and follow instructions in the real world.",
        "color": {
          "r": 0.5397010445594788,
          "g": 0.5397010445594788,
          "b": 0.5397010445594788
        },
        "underline": false,
        "link": null
      }
    ]
  },
