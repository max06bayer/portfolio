  {
    "id": "9:2114",
    "x": 109,
    "y": 9180,
    "w": 1728,
    "h": 218,
    "align": "LEFT",
    "size": 26,
    "weight": "Regular",
    "line": 1.4900000095367432,
    "spacing": -0.78,
    "segments": [
      {
        "text": "BizzConnect was a time and project management platform built around a smart calendar. It automatically rescheduled events to make room for new dates and projects. Hosted at bizzconnect.org, it connected teams through projects, chats, calls and calendars that synced with Google Calendar and Outlook Calendar and automatically scheduled assigned tasks. It also included a collaborative note editor, a company-wide knowledge base and an AI assistant that could perform the same actions as users, with a choice of 25 LLMs. BizzConnect shut down in September 2026.",
        "color": {
          "r": 0.5397010445594788,
          "g": 0.5397010445594788,
          "b": 0.5397010445594788
        },
        "underline": false,
        "link": null
      }
    ]
  },
